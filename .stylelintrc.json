{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "tailwind",
          "apply",
          "variants",
          "responsive",
          "screen",
          "theme",
          "plugin",
          "source",
          "utility",
          "custom-variant"
        ]
      }
    ],
    "no-descending-specificity": null,
    "keyframes-name-pattern": null,
    "selector-class-pattern": null,
    "custom-property-pattern": null,
    "import-notation": null
  },
  "overrides": [
    {
      "files": ["**/*.tsx", "**/*.jsx"],
      "customSyntax": "postcss-styled-syntax"
    }
  ]
}
