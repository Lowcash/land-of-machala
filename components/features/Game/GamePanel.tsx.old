'use client'

import { CharacterPanel } from '@/components/features/Character/CharacterPanel'
import {
  AchievementNotification,
  useAchievements,
} from '@/components/features/Game/AchievementNotification'
import { ArmoryActions } from '@/components/features/Game/ArmoryActions'
import { BankActions } from '@/components/features/Game/BankActions'
import { BlacksmithActions } from '@/components/features/Game/BlacksmithActions'
import { CharacterBox } from '@/components/features/Game/CharacterBox'
import { GameFooter } from '@/components/features/Game/GameFooter'
import { GuildHallActions } from '@/components/features/Game/GuildHallActions'
import { HealerActions } from '@/components/features/Game/HealerActions'
import { LocationActions } from '@/components/features/Game/LocationActions'
import { MarketActions } from '@/components/features/Game/MarketActions'
import { TavernActions } from '@/components/features/Game/TavernActions'
import { TownActions } from '@/components/features/Game/TownActions'
import { WorkshopActions } from '@/components/features/Game/WorkshopActions'
import { CraftingPanel } from '@/components/features/Panels/CraftingPanel'
import { HelpPanel } from '@/components/features/Panels/HelpPanel'
import { InventoryPanel } from '@/components/features/Panels/InventoryPanel'
import { MapPanel } from '@/components/features/Panels/MapPanel'
import { QuestsPanel } from '@/components/features/Panels/QuestsPanel'
import { SettingsPanel } from '@/components/features/Panels/SettingsPanel'
import { SkillsPanel } from '@/components/features/Panels/SkillsPanel'
import {
  Beer,
  Book,
  Building,
  Cross,
  Droplet,
  Flame,
  Hammer,
  Heart,
  Home,
  LogOut,
  Mountain,
  Pickaxe,
  Settings,
  Shield,
  ShoppingBag,
  Sparkles,
  Store,
  Swords,
  Trees,
  Users,
  Zap,
} from 'lucide-react'
import { useRouter, useSearchParams } from 'next/navigation'
import { useEffect, useRef, useState } from 'react'

type View =
  | 'town'
  | 'armory'
  | 'bank'
  | 'healer'
  | 'tavern'
  | 'blacksmith'
  | 'market'
  | 'workshop'
  | 'guild_hall'
  | 'mountains'
  | 'plains'
  | 'desert'
type Panel =
  | 'quests'
  | 'inventory'
  | 'character'
  | 'skills'
  | 'map'
  | 'settings'
  | 'help'
  | 'crafting'
  | null
type ItemType = 'weapon' | 'armor' | 'consumable'

interface Item {
  id: number
  name: string
  type: ItemType
  icon: any
  attack?: number
  defense?: number
  magic?: number
  speed?: number
  healing?: number
  mana?: number
  price?: number
  slot?: string
  equipped?: boolean
  durability?: number
  maxDurability?: number
  level?: number
  strength?: number
  intelligence?: number
  agility?: number
  stamina?: number
}

// Image paths for location backgrounds
const cityImage = '/assets/city-background.jpg'
const armoryImage = '/assets/armory-background.jpg'
const bankImage = '/assets/bank-background.jpg'
const healerImage = '/assets/healer-background.jpg'
const mountainsImage = '/assets/mountains-background.jpg'
const plainsImage = '/assets/plains-background.jpg'
const desertImage = '/assets/desert-background.jpg'

export function GamePanel() {
  const router = useRouter()
  const searchParams = useSearchParams()
  const [currentView, setCurrentView] = useState<View>('town')
  const [panel, setPanel] = useState<Panel>(null)
  const [showSettingsMenu, setShowSettingsMenu] = useState(false)
  const [gold, setGold] = useState(250)
  const [infoText, setInfoText] = useState<string | null>(null)
  const [hp, setHp] = useState(100)
  const [hpMax] = useState(100)
  const [mana] = useState(50)
  const [manaMax] = useState(100)
  const [xp] = useState(75)
  const [xpMax] = useState(100)
  const [characterName] = useState('Lowcash')
  const [level] = useState(1)
  const [characterClass] = useState<
    'warrior' | 'mage' | 'rogue' | 'paladin' | 'ranger' | 'necromancer'
  >('warrior')
  const [dayEnergy, setDayEnergy] = useState(100)
  const [reputation] = useState(0)
  const [showLogoutConfirm, setShowLogoutConfirm] = useState(false)
  const { notifications, unlockAchievement, removeNotification } = useAchievements()
  const [isShaking] = useState(false)
  const [bankGold, setBankGold] = useState(0)
  const [bankItems, setBankItems] = useState<Item[]>([])
  const [bankInvestment, setBankInvestment] = useState(0)
  const [settings, setSettings] = useState({
    sound: true,
    music: true,
    animationSpeed: 1,
    textSpeed: 1,
    autoSave: true,
    combatAnimations: true,
    showTutorial: false,
  })
  const [activeBuffs, setActiveBuffs] = useState<{ name: string; stat: string; val: number }[]>([])

  // Simple Sound Manager
  const playSFX = (type: 'click' | 'attack' | 'damage' | 'gold') => {
    if (typeof window === 'undefined') return
    try {
      const AudioContext = window.AudioContext || (window as any).webkitAudioContext
      if (!AudioContext) return
      const ctx = new AudioContext()
      const osc = ctx.createOscillator()
      const gain = ctx.createGain()
      osc.connect(gain)
      gain.connect(ctx.destination)

      const now = ctx.currentTime

      if (type === 'click') {
        osc.type = 'sine'
        osc.frequency.setValueAtTime(800, now)
        osc.frequency.exponentialRampToValueAtTime(400, now + 0.1)
        gain.gain.setValueAtTime(0.1, now)
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1)
        osc.start(now)
        osc.stop(now + 0.1)
      } else if (type === 'attack') {
        osc.type = 'triangle'
        osc.frequency.setValueAtTime(100, now)
        osc.frequency.linearRampToValueAtTime(300, now + 0.1)
        gain.gain.setValueAtTime(0.2, now)
        gain.gain.linearRampToValueAtTime(0.01, now + 0.15)
        osc.start(now)
        osc.stop(now + 0.15)
      } else if (type === 'damage') {
        osc.type = 'sawtooth'
        osc.frequency.setValueAtTime(100, now)
        osc.frequency.exponentialRampToValueAtTime(50, now + 0.3)
        gain.gain.setValueAtTime(0.2, now)
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.3)
        osc.start(now)
        osc.stop(now + 0.3)
      } else if (type === 'gold') {
        osc.type = 'sine'
        osc.frequency.setValueAtTime(1200, now)
        osc.frequency.exponentialRampToValueAtTime(1800, now + 0.1)
        gain.gain.setValueAtTime(0.1, now)
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.2)
        osc.start(now)
        osc.stop(now + 0.2)
      }
    } catch (e) {
      console.error('Audio error', e)
    }
  }

  // Determine resource type based on class
  const resourceType = ['warrior', 'rogue'].includes(characterClass) ? 'energy' : 'mana'

  // Demo achievement on first visit
  useEffect(() => {
    const hasSeenWelcome = sessionStorage.getItem('welcomeAchievement')
    if (!hasSeenWelcome) {
      setTimeout(() => {
        unlockAchievement({
          id: 1,
          title: 'Vítej v Machale!',
          description: 'Začal jsi své dobrodružství. Hodně štěstí, hrdino!',
          icon: Sparkles,
          rarity: 'common',
        })
      }, 2000)
      sessionStorage.setItem('welcomeAchievement', 'true')
    }
  }, [unlockAchievement])

  // Load view from URL on mount
  useEffect(() => {
    const viewParam = searchParams?.get('view')
    if (
      viewParam &&
      ['town', 'armory', 'bank', 'healer', 'tavern', 'blacksmith', 'market'].includes(viewParam)
    ) {
      setCurrentView(viewParam as View)
    }
  }, [searchParams])

  // URL synchronization removed - using local state only for game view

  const [inventory, setInventory] = useState<Item[]>([
    {
      id: 1,
      name: 'Dřevěný meč',
      type: 'weapon',
      icon: Swords,
      attack: 5,
      slot: 'left_hand',
      equipped: true,
    },
    {
      id: 2,
      name: 'Malý štít',
      type: 'armor',
      icon: Shield,
      defense: 3,
      slot: 'right_hand',
      equipped: true,
    },
    {
      id: 3,
      name: 'Kožená zbroj',
      type: 'armor',
      icon: Shield,
      defense: 8,
      slot: 'chest',
      equipped: true,
    },
    { id: 4, name: 'Lektvar zdraví', type: 'consumable', icon: Heart, healing: 30 },
    { id: 5, name: 'Lektvar zdraví', type: 'consumable', icon: Heart, healing: 30 },
    { id: 6, name: 'Lektvar many', type: 'consumable', icon: Droplet, mana: 30 },
    { id: 7, name: 'Železný meč', type: 'weapon', icon: Swords, attack: 12, slot: 'left_hand' },
    { id: 8, name: 'Ocelová zbroj', type: 'armor', icon: Shield, defense: 15, slot: 'chest' },
    { id: 9, name: 'Kožené rukavice', type: 'armor', icon: Shield, defense: 2, slot: 'hands' },
    { id: 10, name: 'Kožené boty', type: 'armor', icon: Shield, defense: 2, slot: 'feet' },
    { id: 11, name: 'Lektvar zdraví', type: 'consumable', icon: Heart, healing: 30 },
    { id: 12, name: 'Lektvar many', type: 'consumable', icon: Droplet, mana: 30 },
    { id: 13, name: 'Magická hůl', type: 'weapon', icon: Sparkles, magic: 10, slot: 'left_hand' },
    { id: 14, name: 'Rychlé boty', type: 'armor', icon: Zap, speed: 5, slot: 'feet' },
    { id: 15, name: 'Velký štít', type: 'armor', icon: Shield, defense: 8, slot: 'right_hand' },
    { id: 16, name: 'Lektvar zdraví', type: 'consumable', icon: Heart, healing: 30 },
    { id: 17, name: 'Lektvar zdraví', type: 'consumable', icon: Heart, healing: 30 },
    { id: 18, name: 'Lektvar many', type: 'consumable', icon: Droplet, mana: 30 },
    { id: 19, name: 'Železná přilba', type: 'armor', icon: Shield, defense: 5, slot: 'head' },
    { id: 20, name: 'Řetězové rukavice', type: 'armor', icon: Shield, defense: 4, slot: 'hands' },
    { id: 21, name: 'Lektvar zdraví', type: 'consumable', icon: Heart, healing: 30 },
    { id: 22, name: 'Lektvar many', type: 'consumable', icon: Droplet, mana: 30 },
    { id: 23, name: 'Ocelové nohavice', type: 'armor', icon: Shield, defense: 6, slot: 'legs' },
    { id: 24, name: 'Dlouhý meč', type: 'weapon', icon: Swords, attack: 15, slot: 'left_hand' },
    { id: 25, name: 'Bojová sekera', type: 'weapon', icon: Swords, attack: 18, slot: 'left_hand' },
    { id: 26, name: 'Lektvar zdraví', type: 'consumable', icon: Heart, healing: 30 },
    { id: 27, name: 'Lektvar many', type: 'consumable', icon: Droplet, mana: 30 },
    {
      id: 28,
      name: 'Kouzelný plášť',
      type: 'armor',
      icon: Sparkles,
      defense: 3,
      magic: 5,
      slot: 'chest',
    },
    {
      id: 29,
      name: 'Rychlé rukavice',
      type: 'armor',
      icon: Zap,
      defense: 1,
      speed: 3,
      slot: 'hands',
    },
    { id: 30, name: 'Lektvar zdraví', type: 'consumable', icon: Heart, healing: 30 },
  ])

  const [quests] = useState([
    {
      id: 1,
      name: 'Vítej v Machale',
      desc: 'Prozkoumat město a navštívit všechny důležité lokace. Mluv s kupci, poznej obyvatele a zjisti, kde se nacházejí zbrojíř, banka a léčitel.',
      progress: 1,
      total: 3,
      reward: '100 XP, 50g',
      active: true,
    },
    {
      id: 2,
      name: 'První zbraň',
      desc: 'Každý dobrodruh potřebuje pořádnou výzbroj. Navštiv zbrojíře a pořiď si svou první zbraň nebo zbroj.',
      progress: 0,
      total: 1,
      reward: '50 XP',
      active: true,
    },
    {
      id: 3,
      name: 'Lovec potvorů',
      desc: 'V okolí města se objevují nebezpečné tvory. Pomoz městu a zabij alespoň 5 nepřátel, kteří ohrožují obchodní cesty.',
      progress: 2,
      total: 5,
      reward: '200 XP, 100g',
      active: true,
    },
    {
      id: 4,
      name: 'Léčitelův pomocník',
      desc: 'Léčitel potřebuje tvou pomoc se sběrem vzácných léčivých bylin. Najdi 10 bylin v okolních lesích a přines mu je.',
      progress: 3,
      total: 10,
      reward: '150 XP',
      active: true,
    },
    {
      id: 5,
      name: 'Bankovní účet',
      desc: 'Otevři si účet v místní bance, aby tvé peníze a cennosti byly v bezpečí před zloději a lupiči.',
      progress: 0,
      total: 1,
      reward: '50 XP',
      active: false,
    },
    {
      id: 6,
      name: 'Průzkumník',
      desc: 'Prozkoumat 5 různých lokací v Machale a jejím okolí. Každé místo skrývá své tajemství a příležitosti.',
      progress: 1,
      total: 5,
      reward: '100 XP',
      active: true,
    },
    {
      id: 7,
      name: 'Sběrač pokladů',
      desc: 'V jeskyních a podzemích se ukrývají vzácné předměty. Najdi 3 vzácné artefakty.',
      progress: 0,
      total: 3,
      reward: '300 XP, 200g',
      active: false,
    },
    {
      id: 8,
      name: 'Mistr boje',
      desc: 'Staneš se legendárním bojovníkem pouze praxí. Vyhraj 10 soubojů s nepřáteli.',
      progress: 4,
      total: 10,
      reward: '500 XP, 300g',
      active: true,
    },
  ])

  const panelRef = useRef<HTMLDivElement>(null)
  const settingsRef = useRef<HTMLDivElement>(null)

  useEffect(() => {
    const handleClickOutside = (event: MouseEvent) => {
      if (panelRef.current && !panelRef.current.contains(event.target as Node)) {
        const target = event.target as HTMLElement
        if (!target.closest('[data-panel-trigger]')) {
          setPanel(null)
        }
      }
      if (settingsRef.current && !settingsRef.current.contains(event.target as Node)) {
        const target = event.target as HTMLElement
        if (!target.closest('[data-settings-trigger]')) {
          setShowSettingsMenu(false)
        }
      }
    }

    const handleKeyDown = (event: KeyboardEvent) => {
      // ESC - Close panels/menus
      if (event.key === 'Escape') {
        if (panel) {
          setPanel(null)
        } else if (showSettingsMenu) {
          setShowSettingsMenu(false)
        }
      }

      // M - Toggle Map
      if (event.key === 'm' || event.key === 'M') {
        setPanel(panel === 'map' ? null : 'map')
      }

      // Q - Toggle Quests
      if (event.key === 'q' || event.key === 'Q') {
        setPanel(panel === 'quests' ? null : 'quests')
      }

      // I - Toggle Inventory
      if (event.key === 'i' || event.key === 'I') {
        setPanel(panel === 'inventory' ? null : 'inventory')
      }

      // C - Toggle Character
      if (event.key === 'c' || event.key === 'C') {
        setPanel(panel === 'character' ? null : 'character')
      }

      // S - Toggle Skills
      if (event.key === 's' || event.key === 'S') {
        setPanel(panel === 'skills' ? null : 'skills')
      }

      // Arrow keys - Movement
      if (!panel && event.key.startsWith('Arrow')) {
        event.preventDefault()
        if (event.key === 'ArrowUp') handleMove('north')
        if (event.key === 'ArrowDown') handleMove('south')
        if (event.key === 'ArrowLeft') handleMove('west')
        if (event.key === 'ArrowRight') handleMove('east')
      }
    }

    document.addEventListener('mousedown', handleClickOutside)
    document.addEventListener('keydown', handleKeyDown)
    return () => {
      document.removeEventListener('mousedown', handleClickOutside)
      document.removeEventListener('keydown', handleKeyDown)
    }
  }, [panel, showSettingsMenu])

  const handleRest = () => {
    if (gold >= 10) {
      setGold((g) => g - 10)
      setDayEnergy(100)
      setHp(hpMax)
      setActiveBuffs([]) // Clear buffs

      // Calculate interest
      let interestMsg = ''
      if (bankInvestment > 0) {
        const interest = Math.floor(bankInvestment * 0.05)
        if (interest > 0) {
          setBankInvestment((prev) => prev + interest)
          interestMsg = ` <br/>Tvé investice vynesly <span class="text-[#ffd700]">${interest}g</span>.`
        }
      }

      playSFX('gold')
      setInfoText(
        `Odpočinul jsi si v měkké posteli. Tvá energie a zdraví jsou obnoveny. Všechna dočasná požehnání vypršela.${interestMsg}`
      )
    } else {
      setInfoText(
        '<span class="text-[#ff6b6b]">Nemáš dost zlata!</span> Hostinský tě nepustí do pokoje.'
      )
      playSFX('click')
    }
  }

  const handleExplore = () => {
    if (dayEnergy < 10) {
      setInfoText(
        '<span class="text-[#ff6b6b]">Jsi příliš vyčerpaný!</span> Musíš si odpočinout v taverně.'
      )
      playSFX('click')
      return
    }
    setDayEnergy((prev) => Math.max(0, prev - 10))

    const roll = Math.random()
    if (roll < 0.6) {
      router.push('/combat')
    } else if (roll < 0.8) {
      const foundGold = Math.floor(Math.random() * 20) + 10
      setGold((g) => g + foundGold)
      playSFX('gold')
      setInfoText(
        `Při průzkumu jsi našel opuštěný tábor a v něm <span class="text-[#ffd700]">${foundGold} zlaťáků</span>!`
      )
    } else {
      setInfoText(
        'Procházíš krajinou, ale nenarazil jsi na nic zajímavého. Jen vítr šumí v korunách stromů.'
      )
      playSFX('click')
    }
  }

  const handleEquip = (itemId: number) => {
    setInventory((prev) => {
      const item = prev.find((i) => i.id === itemId)
      if (!item) return prev

      return prev.map((i) => {
        if (i.id === itemId) {
          return { ...i, equipped: !i.equipped }
        }
        if (i.slot === item.slot && i.equipped && item.id !== i.id) {
          return { ...i, equipped: false }
        }
        return i
      })
    })
  }

  const calculateStats = () => {
    const baseStats = { strength: 10, intelligence: 5, agility: 10, stamina: 5 }
    const equipped = inventory.filter((i) => i.equipped)

    const stats = equipped.reduce(
      (acc, item) => ({
        strength: acc.strength + (item.strength || 0),
        intelligence: acc.intelligence + (item.intelligence || 0),
        agility: acc.agility + (item.agility || 0),
        stamina: acc.stamina + (item.stamina || 0),
      }),
      baseStats
    )

    activeBuffs.forEach((buff) => {
      // @ts-ignore
      if (stats[buff.stat] !== undefined) {
        // @ts-ignore
        stats[buff.stat] += buff.val
      }
    })

    return stats
  }

  const stats = calculateStats()

  const handleMove = (direction: 'north' | 'south' | 'east' | 'west') => {
    // Navigate to different locations with their backgrounds
    if (direction === 'north') {
      setCurrentView('mountains')
    } else if (direction === 'south') {
      setCurrentView('plains')
    } else if (direction === 'east') {
      setCurrentView('desert')
    } else {
      // West - could add another location later
      setInfoText(
        'Vcházíš na <span class="text-[#ffd700]">západ</span> do <span class="text-[#8b7355]">temného lesa</span>. Stromy jsou husté a světlo sem proniká jen stěží. Měl bys být ve střehu...'
      )
    }
  }

  const viewData = {
    town: {
      bg: cityImage,
      title: 'Město Machala',
      icon: Home,
      desc: 'Nacházíš se v centru města <span class="text-[#ffd700]">Machala</span>, pulzujícího srdce obchodu a dobrodružství. Kolem tebe pobíhají kupci, dobrodruzi a místní obyvatelé. Můžeš navštívit <span class="text-[#6fbf6f]">léčitele</span> pro pomoc a léčení, <span class="text-[#ffd700]">zbrojíře</span> pro zbraně a zbroje, nebo <span class="text-[#ffd700]">banku</span> pro uložení cenností. Za městskými hradbami lze <span class="text-[#ff6b6b]">prozkoumat</span> neznámé končiny plné nebezpečí.',
    },
    armory: {
      bg: armoryImage,
      title: 'Zbrojíř',
      icon: Store,
      desc: 'Vůně kovu a oleje naplňuje vzduch v této dílně. Zbrojíř má široký výběr <span class="text-[#ffd700]">zbraní a zbrojí</span> - od jednoduchých dřevěných mečů po mistrovská ocelová díla. Na stěnách visí přilby, štíty a brnění všech druhů. Můžeš zde <span class="text-[#ffd700]">koupit</span> nebo <span class="text-[#69ccf0]">prodat</span> vybavení.',
    },
    bank: {
      bg: bankImage,
      title: 'Banka',
      icon: Building,
      desc: 'Masivní <span class="text-[#ffd700]">trezor</span> za pultem vzbuzuje důvěru. Tvé cennosti budou v bezpečí za těmito silnými zdmi. Můžeš zde <span class="text-[#ffd700]">uložit</span> peníze i vzácné předměty, které nepoužíváš. Nebo si své uložené <span class="text-[#ffd700]">zlato</span> zase <span class="text-[#69ccf0]">vybrat</span>. Bankéř na tebe přátelsky pokývne.',
    },
    healer: {
      bg: healerImage,
      title: 'Léčitel',
      icon: Cross,
      desc: 'Bylinková vůně a tichá atmosféra tě okamžitě uklidňují. Léčitel může <span class="text-[#6fbf6f]">uzdravit</span> tvá zranění a prodává účinné <span class="text-[#6fbf6f]">lektvary</span>. Na policích vidíš desítky lahviček s různobarevnými tekutinami. Možná pro tebe má i nějaký zajímavý <span class="text-[#ffd700]">quest</span>.',
    },
    tavern: {
      bg: 'https://images.unsplash.com/photo-1746701905946-f1babf656914?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080',
      title: 'Taverna',
      icon: Beer,
      desc: 'Hlasitý smích a zvuk cinkajících hrnků naplňuje prostornou tavernu. Za barem stojí hostinský a čepuje pivo pro hladové dobrodruhy.',
    },
    blacksmith: {
      bg: 'https://images.unsplash.com/photo-1596441560548-2bc4b5e2c361?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080',
      title: 'Kovárna',
      icon: Hammer,
      desc: 'Žhavé uhlí a dunění kladiva vytváří hypnotickou melodii. Kovář umí vykovat zbraně a zbroje z materiálů.',
    },
    market: {
      bg: 'https://images.unsplash.com/photo-1747101412002-0a6f2418f0e3?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080',
      title: 'Tržiště',
      icon: ShoppingBag,
      desc: 'Rušné tržiště plné kupců a obchodníků. Můžeš zde najít opravdu cokoliv, pokud máš dost zlata.',
    },
    workshop: {
      bg: 'https://images.unsplash.com/photo-1596441560548-2bc4b5e2c361?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080',
      title: 'Ateliér',
      icon: Pickaxe,
      desc: 'Žhavé uhlí a dunění kladiva vytváří hypnotickou melodii. Kovář umí vykovat zbraně a zbroje z materiálů.',
    },
    guild_hall: {
      bg: 'https://images.unsplash.com/photo-1596441560548-2bc4b5e2c361?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&q=80&w=1080',
      title: 'Hradová hala',
      icon: Users,
      desc: 'Žhavé uhlí a dunění kladiva vytváří hypnotickou melodii. Kovář umí vykovat zbraně a zbroje z materiálů.',
    },
    mountains: {
      bg: mountainsImage,
      title: 'Horské průsmyky',
      icon: Mountain,
      desc: 'Vydáváš se směrem na <span class="text-[#ffd700]">sever</span> k <span class="text-[#d4a574]">horským průsmykům</span>. Vzduch je tu chladnější a slyšíš ozvěnu větru mezi skalami. V dálce vidíš stezky vedoucí do hor. Možná bys měl být opatrný, kdo ví co se tu <span class="text-[#ff6b6b]">skrývá</span>...',
    },
    plains: {
      bg: plainsImage,
      title: 'Zelené pláně',
      icon: Trees,
      desc: 'Kráčíš na <span class="text-[#ffd700]">jih</span> přes <span class="text-[#6fbf6f]">zelené pláně</span>. Tráva se vlní ve větru a vzduch je plný vůně květů. Krajina se rozprostírá před tebou jako zelený koberec. Zdá se to klidné, ale může to být <span class="text-[#ff6b6b]">klamné</span>...',
    },
    desert: {
      bg: desertImage,
      title: 'Vyprahlá poušť',
      icon: Flame,
      desc: 'Vydáváš se na <span class="text-[#ffd700]">východ</span> k <span class="text-[#ffa500]">vyprahlé poušti</span>. Písek šustí pod tvýma nohama a slunce pálí nemilosrdně. Horko je skoro nesnesitelné. Kdo ví, jaká <span class="text-[#ff6b6b]">nebezpečí</span> se tu skrývají...',
    },
  }[currentView]

  const ViewIcon = viewData.icon

  return (
    <div
      className="fixed inset-0 flex flex-col overflow-hidden bg-[#0a0806]"
      style={{ fontFamily: 'var(--font-body)' }}
    >
      {/* Background with max-width constraint */}
      <div className="absolute inset-0 flex justify-center">
        <div className="relative h-full w-full max-w-[2000px]">
          <img src={viewData.bg} alt={viewData.title} className="h-full w-full object-cover" />
          <div className="absolute inset-0 bg-linear-to-b from-black/50 via-transparent to-black/60"></div>
        </div>
        <div className="pointer-events-none absolute inset-y-0 right-0 left-0">
          <div className="relative mx-auto h-full max-w-[2000px]">
            <div className="absolute inset-y-0 left-0 w-[calc((100vw-2000px)/2)] bg-black"></div>
            <div className="absolute inset-y-0 right-0 w-[calc((100vw-2000px)/2)] bg-black"></div>
          </div>
        </div>
      </div>

      {/* Content Container */}
      <div className="relative z-10 flex flex-1 flex-col">
        {/* Simple Top Bar */}
        <div className="z-[300] border-b border-[#8b6f47] bg-black/80 backdrop-blur-sm">
          <div className="mx-auto flex w-full max-w-5xl items-center justify-between gap-3 px-3 py-2">
            {/* Left - Title */}
            <div className="flex items-center gap-2">
              <ViewIcon className="h-5 w-5 text-[#ffd700]" />
              <h1 className="text-lg text-[#ffd700]" style={{ fontFamily: 'var(--font-fantasy)' }}>
                {viewData.title}
              </h1>
            </div>

            {/* Right - Direct Actions */}
            <div className="flex items-center gap-1">
              <div className="relative">
                <button
                  data-settings-trigger
                  onClick={() => setShowSettingsMenu(!showSettingsMenu)}
                  className="group rounded border border-[#8b6f47] bg-black/60 p-2 transition-all hover:border-[#ffd700] hover:bg-black/80"
                  title="Menu"
                >
                  <Settings className="h-4 w-4 text-[#d4a574] group-hover:text-[#ffd700]" />
                </button>

                {showSettingsMenu && (
                  <div className="absolute top-full right-0 z-50 mt-2 w-48 rounded border border-[#d4a574] bg-black/95 shadow-xl backdrop-blur-md">
                    <button
                      onClick={() => {
                        setPanel('help')
                        setShowSettingsMenu(false)
                      }}
                      className="flex w-full items-center gap-2 border-b border-[#8b6f47]/30 px-4 py-3 text-left text-[#d4a574] hover:bg-white/5 hover:text-[#ffd700]"
                    >
                      <Book className="h-4 w-4" /> Nápověda
                    </button>
                    <button
                      onClick={() => {
                        setPanel('settings')
                        setShowSettingsMenu(false)
                      }}
                      className="flex w-full items-center gap-2 border-b border-[#8b6f47]/30 px-4 py-3 text-left text-[#d4a574] hover:bg-white/5 hover:text-[#ffd700]"
                    >
                      <Settings className="h-4 w-4" /> Nastavení
                    </button>
                    <button
                      onClick={() => {
                        setShowLogoutConfirm(true)
                        setShowSettingsMenu(false)
                      }}
                      className="flex w-full items-center gap-2 px-4 py-3 text-left text-[#ff6b6b] hover:bg-white/5 hover:text-[#ff4444]"
                    >
                      <LogOut className="h-4 w-4" /> Odhlásit se
                    </button>
                  </div>
                )}
              </div>
            </div>
          </div>
        </div>

        {/* Main Container with max-width */}
        <div className="mx-auto flex w-full max-w-5xl flex-1 gap-3 overflow-hidden p-3">
          <div className="flex min-w-0 flex-1 flex-col gap-3">
            {/* Player box at top - constrained width */}
            <div className="w-full max-w-sm">
              <CharacterBox
                name={characterName}
                level={level}
                hp={hp}
                hpMax={hpMax}
                mana={mana}
                manaMax={manaMax}
                xp={xp}
                xpMax={xpMax}
                stats={stats}
                isEnemy={false}
                resourceType={resourceType}
              />
            </div>

            {/* Central Info Panel - medium size with wave animation */}
            <div
              className={`h-[140px] shrink-0 overflow-hidden rounded border border-[#d4a574]/50 bg-black/70 backdrop-blur-sm transition-colors ${isShaking ? 'shake border-[#ff4444]' : ''}`}
            >
              <div className="scrollbar-custom h-full overflow-y-auto p-4">
                <div
                  className="mx-auto max-w-2xl animate-[fadeInWave_0.6s_ease-out] py-1 text-center text-sm leading-relaxed text-[#f5e6d3]"
                  key={infoText || viewData.desc}
                  dangerouslySetInnerHTML={{ __html: infoText || viewData.desc }}
                />
              </div>
            </div>

            {/* Actions - flexible height */}
            <div className="scrollbar-custom relative min-h-0 flex-1 overflow-y-auto rounded border border-[#d4a574]/50 bg-black/70 p-3 backdrop-blur-sm">
              {currentView === 'town' && (
                <TownActions
                  onExplore={handleExplore}
                  onArmory={() => setCurrentView('armory')}
                  onBank={() => setCurrentView('bank')}
                  onHealer={() => setCurrentView('healer')}
                  onTavern={() => setCurrentView('tavern')}
                  onBlacksmith={() => setCurrentView('blacksmith')}
                  onMarket={() => setCurrentView('market')}
                  onMove={handleMove}
                  setInfoText={setInfoText}
                />
              )}
              {currentView === 'armory' && <ArmoryActions onBack={() => setCurrentView('town')} />}
              {currentView === 'bank' && (
                <BankActions
                  onBack={() => setCurrentView('town')}
                  gold={gold}
                  setGold={setGold}
                  bankGold={bankGold}
                  setBankGold={setBankGold}
                  bankItems={bankItems}
                  setBankItems={setBankItems}
                  inventory={inventory}
                  setInventory={setInventory}
                  bankInvestment={bankInvestment}
                  setBankInvestment={setBankInvestment}
                />
              )}
              {currentView === 'healer' && (
                <HealerActions
                  onBack={() => setCurrentView('town')}
                  gold={gold}
                  setGold={setGold}
                  activeBuffs={activeBuffs}
                  setActiveBuffs={setActiveBuffs}
                  setInfoText={setInfoText}
                />
              )}
              {currentView === 'tavern' && (
                <TavernActions
                  onBack={() => setCurrentView('town')}
                  onRest={handleRest}
                  gold={gold}
                  setGold={setGold}
                  setInfoText={setInfoText}
                />
              )}
              {currentView === 'blacksmith' && (
                <BlacksmithActions
                  onBack={() => setCurrentView('town')}
                  gold={gold}
                  setGold={setGold}
                  inventory={inventory}
                  setInventory={setInventory}
                  setInfoText={setInfoText}
                />
              )}
              {currentView === 'market' && (
                <MarketActions
                  onBack={() => setCurrentView('town')}
                  gold={gold}
                  setGold={setGold}
                  inventory={inventory}
                  setInventory={setInventory}
                  setInfoText={setInfoText}
                />
              )}
              {currentView === 'workshop' && (
                <WorkshopActions
                  onBack={() => setCurrentView('town')}
                  onOpenCrafting={() => setPanel('crafting')}
                  onOpenEnchanting={() => setPanel('crafting')}
                  setInfoText={setInfoText}
                />
              )}
              {currentView === 'guild_hall' && (
                <GuildHallActions
                  onBack={() => setCurrentView('town')}
                  setInfoText={setInfoText}
                  playerReputation={reputation}
                />
              )}
              {currentView === 'mountains' && (
                <LocationActions
                  onBack={() => setCurrentView('town')}
                  onCombat={() => router.push('/combat')}
                />
              )}
              {currentView === 'plains' && (
                <LocationActions
                  onBack={() => setCurrentView('town')}
                  onCombat={() => router.push('/combat')}
                />
              )}
              {currentView === 'desert' && (
                <LocationActions
                  onBack={() => setCurrentView('town')}
                  onCombat={() => router.push('/combat')}
                />
              )}
            </div>
          </div>
        </div>

        <GameFooter panel={panel} setPanel={setPanel} />
      </div>

      {/* Panels */}
      {panel && (
        <div ref={panelRef}>
          {panel === 'settings' && (
            <SettingsPanel
              settings={settings}
              setSettings={setSettings}
              onClose={() => setPanel(null)}
            />
          )}
          {panel === 'help' && <HelpPanel onClose={() => setPanel(null)} />}
          {panel === 'inventory' && (
            <InventoryPanel
              inventory={inventory}
              onEquip={handleEquip}
              onClose={() => setPanel(null)}
            />
          )}
          {panel === 'quests' && <QuestsPanel quests={quests} onClose={() => setPanel(null)} />}
          {panel === 'skills' && <SkillsPanel stats={stats} onClose={() => setPanel(null)} />}
          {panel === 'map' && (
            <MapPanel currentLocation={currentView} onClose={() => setPanel(null)} />
          )}
          {panel === 'character' && <CharacterPanel />}
          {panel === 'crafting' && <CraftingPanel onClose={() => setPanel(null)} />}
        </div>
      )}

      {/* Logout Confirmation */}
      {showLogoutConfirm && (
        <div className="fixed inset-0 z-[200] flex items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
          <div className="relative w-full max-w-sm rounded-lg border-2 border-[#d4a574] bg-black/90 p-6 shadow-2xl">
            <h3
              className="mb-2 text-center text-xl text-[#ffd700]"
              style={{ fontFamily: 'var(--font-fantasy)' }}
            >
              Odhlásit se?
            </h3>
            <p className="mb-6 text-center text-[#8b7355]">
              Opravdu chceš opustit svět Machala? Neuložený postup může být ztracen.
            </p>
            <div className="flex gap-3">
              <button
                onClick={() => setShowLogoutConfirm(false)}
                className="flex-1 rounded border border-[#8b6f47] py-2 text-[#d4a574] transition-colors hover:bg-black/50"
              >
                Zůstat
              </button>
              <button
                onClick={() => router.push('/login')}
                className="flex-1 rounded border border-[#ff4444] bg-[#8b2f2f] py-2 text-white transition-colors hover:bg-[#a33]"
              >
                Odhlásit
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Achievement Notifications */}
      {notifications.map((achievement) => (
        <AchievementNotification
          key={achievement.id}
          achievement={achievement}
          onClose={() => removeNotification(achievement.id)}
        />
      ))}
    </div>
  )
}
