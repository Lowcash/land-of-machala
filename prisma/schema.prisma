generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  username     String?     @unique
  isGuest      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  characters   Character[]

  @@map("users")
}

model Character {
  id                          String                 @id @default(cuid())
  userId                      String
  serverId                    String                 @default("default")
  name                        String
  race                        CharacterRace
  class                       CharacterClass
  strength                    Int                    @default(10)
  intelligence                Int                    @default(10)
  agility                     Int                    @default(10)
  stamina                     Int                    @default(10)
  level                       Int                    @default(1)
  experience                  Int                    @default(0)
  hp                          Int                    @default(100)
  maxHp                       Int                    @default(100)
  mana                        Int                    @default(50)
  maxMana                     Int                    @default(50)
  gold                        Int                    @default(0)
  physicalResistance          Int                    @default(0)
  magicalResistance           Int                    @default(0)
  fireResistance              Int                    @default(0)
  coldResistance              Int                    @default(0)
  poisonResistance            Int                    @default(0)
  locationX                   Int                    @default(0)
  locationY                   Int                    @default(0)
  currentView                 String                 @default("town")
  discoveredLocations         Json?
  questMarkers                Json?
  lootExpirationNotifications Json?
  inCombat                    Boolean                @default(false)
  combatEnemyId               String?
  combatTurn                  String?
  combatPlayerHp              Int?
  combatEnemyHp               Int?
  talentPoints                Int                    @default(0)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  lastPlayedAt                DateTime               @default(now())
  currentEnemyId              String?
  deathLocation               Json?
  preCombatLocation           Json?
  bankGold                    Int                    @default(0)
  bankItems                   BankItem[]
  achievements                CharacterAchievement[]
  quests                      CharacterQuest[]
  skills                      CharacterSkill[]
  user                        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventory                   InventoryItem[]
  buffs                       CharacterBuff[]

  @@index([userId])
  @@map("characters")
}

model Item {
  id             String          @id @default(cuid())
  name           String
  type           ItemType
  rarity         ItemRarity      @default(COMMON)
  description    String?
  value          Int             @default(0)
  iconName       String
  slot           EquipmentSlot?
  strength       Int             @default(0)
  intelligence   Int             @default(0)
  agility        Int             @default(0)
  stamina        Int             @default(0)
  healing        Int             @default(0)
  manaRestore    Int             @default(0)
  createdAt      DateTime        @default(now())
  bankItems      BankItem[]
  inventoryItems InventoryItem[]
  questRewards   QuestReward[]

  @@map("items")
}

model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  itemId      String
  quantity    Int       @default(1)
  equipped    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id])

  @@index([characterId])
  @@index([itemId])
  @@map("inventory_items")
}

model BankItem {
  id          String    @id @default(cuid())
  characterId String
  itemId      String
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  item        Item      @relation(fields: [itemId], references: [id])

  @@index([characterId])
  @@index([itemId])
  @@map("bank_items")
}

model Quest {
  id          String           @id @default(cuid())
  title       String
  description String
  category    QuestCategory
  level       Int              @default(1)
  giver       String?
  location    String?
  story       String?
  rewardGold  Int              @default(0)
  rewardXp    Int              @default(0)
  createdAt   DateTime         @default(now())
  characters  CharacterQuest[]
  objectives  QuestObjective[]
  rewards     QuestReward[]

  @@map("quests")
}

model QuestObjective {
  id          String @id @default(cuid())
  questId     String
  description String
  target      Int    @default(1)
  order       Int    @default(0)
  quest       Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([questId])
  @@map("quest_objectives")
}

model QuestReward {
  id       String  @id @default(cuid())
  questId  String
  itemId   String?
  quantity Int     @default(1)
  item     Item?   @relation(fields: [itemId], references: [id])
  quest    Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([questId])
  @@map("quest_rewards")
}

model CharacterQuest {
  id          String                    @id @default(cuid())
  characterId String
  questId     String
  status      QuestStatus               @default(AVAILABLE)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime                  @default(now())
  objectives  CharacterQuestObjective[]
  character   Character                 @relation(fields: [characterId], references: [id], onDelete: Cascade)
  quest       Quest                     @relation(fields: [questId], references: [id])

  @@unique([characterId, questId])
  @@index([characterId])
  @@index([questId])
  @@map("character_quests")
}

model CharacterQuestObjective {
  id               String         @id @default(cuid())
  characterQuestId String
  objectiveId      String
  current          Int            @default(0)
  completed        Boolean        @default(false)
  characterQuest   CharacterQuest @relation(fields: [characterQuestId], references: [id], onDelete: Cascade)

  @@index([characterQuestId])
  @@map("character_quest_objectives")
}

model Skill {
  id                 String           @id @default(cuid())
  name               String
  description        String
  tree               SkillTree
  tier               Int
  maxRank            Int              @default(1)
  iconName           String
  requiredLevel      Int?
  requiredSkillId    String?
  requiredTreePoints Int              @default(0)
  positionX          Int              @default(0)
  positionY          Int              @default(0)
  createdAt          DateTime         @default(now())
  characters         CharacterSkill[]

  @@map("skills")
}

model CharacterSkill {
  id          String    @id @default(cuid())
  characterId String
  skillId     String
  currentRank Int       @default(0)
  unlocked    Boolean   @default(false)
  active      Boolean   @default(false)
  unlockedAt  DateTime?
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skill       Skill     @relation(fields: [skillId], references: [id])

  @@unique([characterId, skillId])
  @@index([characterId])
  @@index([skillId])
  @@map("character_skills")
}

model Enemy {
  id               String        @id @default(cuid())
  name             String
  level            Int           @default(1)
  maxHp            Int           @default(50)
  attack           Int           @default(10)
  defense          Int           @default(5)
  magic            Int           @default(0)
  behavior         EnemyBehavior @default(BALANCED)
  goldReward       Int           @default(10)
  experienceReward Int           @default(25)
  iconName         String
  createdAt        DateTime      @default(now())

  @@map("enemies")
}

model Achievement {
  id          String                 @id @default(cuid())
  title       String
  description String
  category    AchievementCategory
  rarity      AchievementRarity      @default(COMMON)
  maxProgress Int                    @default(1)
  iconName    String
  rewardGold  Int                    @default(0)
  rewardXp    Int                    @default(0)
  rewardTitle String?
  hidden      Boolean                @default(false)
  createdAt   DateTime               @default(now())
  characters  CharacterAchievement[]

  @@map("achievements")
}

model CharacterAchievement {
  id            String      @id @default(cuid())
  characterId   String
  achievementId String
  progress      Int         @default(0)
  unlocked      Boolean     @default(false)
  unlockedAt    DateTime?
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@unique([characterId, achievementId])
  @@index([characterId])
  @@index([achievementId])
  @@map("character_achievements")
}

model Location {
  id              String       @id @default(cuid())
  serverId        String       @default("default")
  name            String       @unique
  type            LocationType
  description     String?
  level           Int          @default(1)
  positionX       Int
  positionY       Int
  discoveryRadius Int          @default(5)
  isSafeZone      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  questGiverId    String?
  questTurnInId   String?

  @@map("locations")
}

model ActivityLog {
  id          String   @id @default(cuid())
  characterId String?
  serverId    String   @default("default")
  message     String
  metadata    Json?
  createdAt   DateTime @default(now())
  global      Boolean  @default(false)
  timestamp   DateTime @default(now())
  type        String

  @@index([characterId])
  @@index([serverId])
  @@index([timestamp])
  @@map("activity_logs")
}

model CharacterBuff {
  id          String    @id @default(cuid())
  characterId String
  type        String // e.g., "STR", "STA"
  value       Int
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([characterId])
  @@unique([characterId, type])
  @@map("character_buffs")
}

enum CharacterRace {
  HUMAN
  DWARF
  ELF
  ORC
  HALFLING
  DRAGONBORN
}

enum CharacterClass {
  WARRIOR
  MAGE
  ROGUE
  PALADIN
  RANGER
  NECROMANCER
}

enum ItemType {
  WEAPON
  ARMOR
  CONSUMABLE
  MATERIAL
  QUEST
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum EquipmentSlot {
  HEAD
  CHEST
  LEGS
  FEET
  HANDS
  WEAPON
  OFFHAND
}

enum QuestCategory {
  MAIN
  SIDE
  DAILY
  EVENT
}

enum QuestStatus {
  AVAILABLE
  ACTIVE
  COMPLETED
  FAILED
}

enum SkillTree {
  COMBAT
  DEFENSE
  MAGIC
  STEALTH
  CRAFTING
}

enum EnemyBehavior {
  AGGRESSIVE
  DEFENSIVE
  BALANCED
}

enum AchievementCategory {
  COMBAT
  EXPLORATION
  QUESTS
  SOCIAL
  COLLECTION
  PROGRESSION
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum LocationType {
  TOWN
  DUNGEON
  WILDERNESS
  LANDMARK
}
