generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String         @map("password_hash")
  emailVerifiedAt DateTime?      @map("email_verified_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  sessions        AuthSession[]
  profile         PlayerProfile?
  characters      Character[]
  gameRuns        GameRun[]

  @@map("users")
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  sessionTokenHash String   @unique @map("session_token_hash")
  expiresAt        DateTime @map("expires_at")
  rememberMe       Boolean  @default(false) @map("remember_me")
  ipAddressHash    String?  @map("ip_address_hash")
  userAgent        String?  @map("user_agent")
  createdAt        DateTime @default(now()) @map("created_at")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PlayerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique @map("user_id")
  displayName         String   @map("display_name")
  locale              String   @default("cs")
  onboardingCompleted Boolean  @default(false) @map("onboarding_completed")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("player_profiles")
}

model Character {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  name             String
  raceId           String    @map("race_id")
  classId          String    @map("class_id")
  statSnapshotJson Json      @map("stat_snapshot_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameRuns         GameRun[]

  @@index([userId])
  @@map("characters")
}

model GameRun {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  characterId String              @map("character_id")
  phase       String
  locationKey String              @map("location_key")
  status      String
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  character   Character           @relation(fields: [characterId], references: [id], onDelete: Cascade)
  snapshots   GameStateSnapshot[]

  @@index([userId])
  @@index([characterId])
  @@index([status])
  @@map("game_runs")
}

model GameStateSnapshot {
  id            String   @id @default(cuid())
  gameRunId     String   @map("game_run_id")
  schemaVersion Int      @map("schema_version")
  stateJson     Json     @map("state_json")
  createdAt     DateTime @default(now()) @map("created_at")
  gameRun       GameRun  @relation(fields: [gameRunId], references: [id], onDelete: Cascade)

  @@index([gameRunId, createdAt])
  @@map("game_state_snapshots")
}
