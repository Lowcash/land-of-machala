// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// Auth Models (NextAuth v5 compatible)
model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  username     String?     @unique
  isGuest      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  characters   Character[]

  @@map("users")
}

// Character System
model Character {
  id     String         @id @default(cuid())
  userId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name   String
  race   CharacterRace
  class  CharacterClass

  // Primary stats
  strength     Int @default(10)
  intelligence Int @default(10)
  agility      Int @default(10)
  stamina      Int @default(10)

  // Derived stats
  level      Int @default(1)
  experience Int @default(0)
  hp         Int @default(100)
  maxHp      Int @default(100)
  mana       Int @default(50)
  maxMana    Int @default(50)
  gold       Int @default(0)

  // Resistances (percentage)
  physicalResistance Int @default(0)
  magicalResistance  Int @default(0)
  fireResistance     Int @default(0)
  coldResistance     Int @default(0)
  poisonResistance   Int @default(0)

  // Location
  locationX   Int    @default(0)
  locationY   Int    @default(0)
  currentView String @default("town")

  // Combat state (for SSR protection)
  inCombat       Boolean @default(false)
  combatEnemyId  String?
  combatTurn     String? // "player" or "enemy"
  combatPlayerHp Int?
  combatEnemyHp  Int?

  // Progression
  talentPoints Int @default(0)

  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastPlayedAt DateTime @default(now())

  // Relations
  inventory    InventoryItem[]
  bankItems    BankItem[]
  quests       CharacterQuest[]
  skills       CharacterSkill[]
  achievements CharacterAchievement[]

  @@index([userId])
  @@map("characters")
}

enum CharacterRace {
  HUMAN
  DWARF
  ELF
  ORC
  HALFLING
  DRAGONBORN
}

enum CharacterClass {
  WARRIOR
  MAGE
  ROGUE
  PALADIN
  RANGER
  NECROMANCER
}

// Item System
model Item {
  id          String     @id @default(cuid())
  name        String
  type        ItemType
  rarity      ItemRarity @default(COMMON)
  description String?
  value       Int        @default(0)
  iconName    String

  // Equipment specific
  slot EquipmentSlot?

  // Stats
  strength     Int @default(0)
  intelligence Int @default(0)
  agility      Int @default(0)
  stamina      Int @default(0)
  healing      Int @default(0)
  manaRestore  Int @default(0)

  // Relations
  inventoryItems InventoryItem[]
  bankItems      BankItem[]
  questRewards   QuestReward[]

  createdAt DateTime @default(now())

  @@map("items")
}

enum ItemType {
  WEAPON
  ARMOR
  CONSUMABLE
  MATERIAL
  QUEST
}

enum ItemRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

enum EquipmentSlot {
  HEAD
  CHEST
  LEGS
  FEET
  HANDS
  WEAPON
  OFFHAND
}

// Inventory
model InventoryItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  quantity    Int       @default(1)
  equipped    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([characterId])
  @@index([itemId])
  @@map("inventory_items")
}

// Bank Storage
model BankItem {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  quantity    Int       @default(1)
  createdAt   DateTime  @default(now())

  @@index([characterId])
  @@index([itemId])
  @@map("bank_items")
}

// Quest System
model Quest {
  id          String        @id @default(cuid())
  title       String
  description String
  category    QuestCategory
  level       Int           @default(1)
  giver       String? // NPC name
  location    String?
  story       String?

  // Rewards
  rewardGold Int @default(0)
  rewardXp   Int @default(0)

  // Relations
  objectives QuestObjective[]
  rewards    QuestReward[]
  characters CharacterQuest[]

  createdAt DateTime @default(now())

  @@map("quests")
}

enum QuestCategory {
  MAIN
  SIDE
  DAILY
  EVENT
}

model QuestObjective {
  id          String @id @default(cuid())
  questId     String
  quest       Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)
  description String
  target      Int    @default(1)
  order       Int    @default(0)

  @@index([questId])
  @@map("quest_objectives")
}

model QuestReward {
  id       String  @id @default(cuid())
  questId  String
  quest    Quest   @relation(fields: [questId], references: [id], onDelete: Cascade)
  itemId   String?
  item     Item?   @relation(fields: [itemId], references: [id])
  quantity Int     @default(1)

  @@index([questId])
  @@map("quest_rewards")
}

model CharacterQuest {
  id          String      @id @default(cuid())
  characterId String
  character   Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest       @relation(fields: [questId], references: [id])
  status      QuestStatus @default(AVAILABLE)

  // Progress tracking
  objectives CharacterQuestObjective[]

  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([characterId, questId])
  @@index([characterId])
  @@index([questId])
  @@map("character_quests")
}

enum QuestStatus {
  AVAILABLE
  ACTIVE
  COMPLETED
  FAILED
}

model CharacterQuestObjective {
  id               String         @id @default(cuid())
  characterQuestId String
  characterQuest   CharacterQuest @relation(fields: [characterQuestId], references: [id], onDelete: Cascade)
  objectiveId      String
  current          Int            @default(0)
  completed        Boolean        @default(false)

  @@index([characterQuestId])
  @@map("character_quest_objectives")
}

// Skill System
model Skill {
  id          String    @id @default(cuid())
  name        String
  description String
  tree        SkillTree
  tier        Int // 1-5
  maxRank     Int       @default(1)
  iconName    String

  // Requirements
  requiredLevel      Int?
  requiredSkillId    String?
  requiredTreePoints Int     @default(0)

  // Position for UI
  positionX Int @default(0)
  positionY Int @default(0)

  // Relations
  characters CharacterSkill[]

  createdAt DateTime @default(now())

  @@map("skills")
}

enum SkillTree {
  COMBAT
  DEFENSE
  MAGIC
  STEALTH
  CRAFTING
}

model CharacterSkill {
  id          String    @id @default(cuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill     @relation(fields: [skillId], references: [id])
  currentRank Int       @default(0)
  unlocked    Boolean   @default(false)
  active      Boolean   @default(false)

  unlockedAt DateTime?

  @@unique([characterId, skillId])
  @@index([characterId])
  @@index([skillId])
  @@map("character_skills")
}

// Enemy System (for combat)
model Enemy {
  id               String        @id @default(cuid())
  name             String
  level            Int           @default(1)
  maxHp            Int           @default(50)
  attack           Int           @default(10)
  defense          Int           @default(5)
  magic            Int           @default(0)
  behavior         EnemyBehavior @default(BALANCED)
  goldReward       Int           @default(10)
  experienceReward Int           @default(25)
  iconName         String

  createdAt DateTime @default(now())

  @@map("enemies")
}

enum EnemyBehavior {
  AGGRESSIVE
  DEFENSIVE
  BALANCED
}

// Achievement System
model Achievement {
  id          String              @id @default(cuid())
  title       String
  description String
  category    AchievementCategory
  rarity      AchievementRarity   @default(COMMON)
  maxProgress Int                 @default(1)
  iconName    String

  // Rewards
  rewardGold  Int     @default(0)
  rewardXp    Int     @default(0)
  rewardTitle String?

  hidden Boolean @default(false)

  // Relations
  characters CharacterAchievement[]

  createdAt DateTime @default(now())

  @@map("achievements")
}

enum AchievementCategory {
  COMBAT
  EXPLORATION
  QUESTS
  SOCIAL
  COLLECTION
  PROGRESSION
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

model CharacterAchievement {
  id            String      @id @default(cuid())
  characterId   String
  character     Character   @relation(fields: [characterId], references: [id], onDelete: Cascade)
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id])
  progress      Int         @default(0)
  unlocked      Boolean     @default(false)

  unlockedAt DateTime?

  @@unique([characterId, achievementId])
  @@index([characterId])
  @@index([achievementId])
  @@map("character_achievements")
}

// Location/Map System
model Location {
  id          String       @id @default(cuid())
  name        String       @unique
  type        LocationType
  description String?
  level       Int          @default(1)
  positionX   Int
  positionY   Int

  createdAt DateTime @default(now())

  @@map("locations")
}

enum LocationType {
  TOWN
  DUNGEON
  WILDERNESS
  LANDMARK
}
